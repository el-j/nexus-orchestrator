{
  "name": "nexus-orchestrator",
  "displayName": "Nexus Orchestrator",
  "description": "Route AI code-generation tasks through nexusOrchestrator",
  "version": "0.2.0-62",
  "publisher": "el-j",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/el-j/nexus-orchestrator"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexus-orchestrator",
          "title": "Nexus Orchestrator",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "nexus-orchestrator": [
        {
          "id": "nexus.taskQueue",
          "name": "Task Queue"
        },
        {
          "id": "nexus.workspaceAgents",
          "name": "Workspace Agents",
          "icon": "$(organization)"
        },
        {
          "id": "nexus.aiSessions",
          "name": "AI Agents",
          "icon": "$(robot)",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "nexus.sendCurrentContext",
        "title": "Nexus: Send Current Context To Queue"
      },
      {
        "command": "nexus.submitTask",
        "title": "Nexus: Compose Manual Task"
      },
      {
        "command": "nexus.viewQueue",
        "title": "Nexus: View Task Queue"
      },
      {
        "command": "nexus.showActivityLog",
        "title": "Nexus: Show Activity Log"
      },
      {
        "command": "nexus.selectProvider",
        "title": "Nexus: Select Provider / Model"
      },
      {
        "command": "nexus.showProviders",
        "title": "Nexus: Show Providers"
      },
      {
        "command": "nexus.statusBarAction",
        "title": "Nexus: Status Bar Actions"
      },
      {
        "command": "nexus.cancelTask",
        "title": "Nexus: Cancel Task",
        "icon": "$(trash)"
      },
      {
        "command": "nexus.refreshWorkspaceAgents",
        "title": "Nexus: Refresh Workspace Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "nexus.refreshAISessions",
        "title": "Refresh AI Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "nexus.delegateToNexus",
        "title": "Send to Nexus Orchestrator",
        "icon": "$(arrow-up)"
      },
      {
        "command": "nexus.delegateAllSessions",
        "title": "Delegate All Active Agents"
      },
      {
        "command": "nexus.toggleWorkspaceScope",
        "title": "Nexus: Toggle Workspace Scope",
        "category": "Nexus",
        "icon": "$(filter)"
      },
      {
        "command": "nexus.reconnect",
        "title": "Nexus: Reconnect to Daemon",
        "category": "Nexus"
      },
      {
        "command": "nexus.brain.ingest",
        "title": "Nexus: Ingest Knowledge into Brain",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nexus.brain.status",
        "title": "Nexus: Get Brain Status",
        "icon": "$(database)"
      },
      {
        "command": "nexus.brain.init",
        "title": "Nexus: Initialize Project Brain",
        "icon": "$(rocket)"
      },
      {
        "command": "nexus.brain.search",
        "title": "Nexus: Search Project Brain",
        "icon": "$(search)"
      },
      {
        "command": "nexus.brain.listKnowledge",
        "title": "Nexus: List Project Knowledge",
        "icon": "$(list-unordered)"
      },
      {
        "command": "nexus.brain.getContext",
        "title": "Nexus: Get Project Context",
        "icon": "$(book)"
      },
      {
        "command": "nexus.brain.getFileMap",
        "title": "Nexus: Get Project File Map",
        "icon": "$(file-directory)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nexus.sendCurrentContext",
          "when": "view == nexus.taskQueue",
          "group": "navigation"
        },
        {
          "command": "nexus.showActivityLog",
          "when": "view == nexus.taskQueue",
          "group": "navigation@2"
        },
        {
          "command": "nexus.refreshWorkspaceAgents",
          "when": "view == nexus.workspaceAgents",
          "group": "navigation"
        },
        {
          "command": "nexus.refreshAISessions",
          "when": "view == nexus.aiSessions",
          "group": "navigation"
        },
        {
          "command": "nexus.toggleWorkspaceScope",
          "when": "view == nexus.taskQueue",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "nexus.sendCurrentContext",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "nexus.sendCurrentContext",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nexus.cancelTask",
          "when": "viewItem == nexusTask",
          "group": "inline"
        },
        {
          "command": "nexus.delegateToNexus",
          "when": "view == nexus.aiSessions && viewItem == aiSession",
          "group": "inline"
        },
        {
          "command": "nexus.brain.ingest",
          "when": "viewItem == nexusProjectBrain",
          "group": "inline"
        },
        {
          "command": "nexus.brain.status",
          "when": "viewItem == nexusProjectBrain",
          "group": "brain@1"
        },
        {
          "command": "nexus.brain.init",
          "when": "viewItem == nexusProjectBrain",
          "group": "brain@2"
        },
        {
          "command": "nexus.brain.search",
          "when": "viewItem == nexusProjectBrain",
          "group": "brain@3"
        },
        {
          "command": "nexus.brain.listKnowledge",
          "when": "viewItem == nexusProjectBrain",
          "group": "brain@4"
        },
        {
          "command": "nexus.brain.getContext",
          "when": "viewItem == nexusProjectBrain",
          "group": "brain@5"
        },
        {
          "command": "nexus.brain.getFileMap",
          "when": "viewItem == nexusProjectBrain",
          "group": "brain@6"
        }
      ]
    },
    "configuration": {
      "title": "Nexus Orchestrator",
      "properties": {
        "nexus.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:63987",
          "description": "URL of the nexusOrchestrator daemon"
        },
        "nexus.defaultProvider": {
          "type": "string",
          "default": "",
          "description": "Default provider name for task submissions"
        },
        "nexus.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model for task submissions"
        },
        "nexus.mcpPort": {
          "type": "number",
          "default": 63988,
          "description": "Port of the nexusOrchestrator MCP server (JSON-RPC 2.0). Must match NEXUS_MCP_ADDR on the daemon."
        },
        "nexus.enableMCPPortSweep": {
          "type": "boolean",
          "default": true,
          "description": "When true, nexusOrchestrator probes a curated set of localhost ports for MCP-compatible servers during agent discovery. Disable if you experience unexpected connections to local services."
        },
        "nexus.scopeToWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "When true, the Task Queue panel shows only tasks for the current workspace folder. Toggle with the filter button or the 'Nexus: Toggle Workspace Scope' command."
        }
      }
    },
    "mcpServers": {
      "nexus-orchest": {
        "label": "Nexus Orchestrator",
        "type": "http",
        "url": "http://127.0.0.1:${config:nexus.mcpPort}/mcp"
      }
    }
  },
  "scripts": {
    "compile": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vscode/vsce": "^3.4.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
