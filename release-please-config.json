{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "skip-changelog": true,
  "packages": {
    ".": {
      "package-name": "nexus-orchestrator",
      "extra-files": [
        { "type": "json", "path": "frontend/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "vscode-extension/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "github-action/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "docs/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "wails.json", "jsonpath": "$.info.productVersion" }
      ]
    }
  }
}
